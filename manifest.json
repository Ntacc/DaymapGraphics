{
    "manifest_version": 3,
    "name": "Daymap Graphics",
    "version": "8.0.1",
    "description": "Daymap is currently plain and boring. With Daymap Graphics, customise colour, transparency, blurred background, and more!",
    "permissions": [
		"storage"
    ],
	"content_scripts": [
		{
			"matches": ["*://*.daymap.net/*", "*://*.sa.edu.au/daymap*"],
			"js": ["daymapGraphics.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["headerMenus.js", "popup.js", "resources.json"],
			"matches": ["*://*.daymap.net/*", "*://*.sa.edu.au/*"]
		}
	],
    "icons": {
		"128": "128.png"
    },
	"action": {
		"default_popup": "popup.html",
		"default_icon": "128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "{88e25e4f-ff2f-48e1-86b2-5a4a88943f78}"
		}
	}
}
